# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/fitpantry

# JWT authentication
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=7d

# Optional USDA FoodData Central API key
# Get one free at: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
